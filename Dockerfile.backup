FROM postgres:18.6-bookworm@sha256:bbf83594798e144bff365a9c191c5d779f181fb3135902064ab8ff11918020fc

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        age \
        awscli \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=0755 scripts/backup_postgres.sh /usr/local/bin/backup-postgres

ENV HOME=/tmp

USER postgres
ENTRYPOINT ["/usr/local/bin/backup-postgres"]
